PORT=5000
# Set WEB_ORIGIN to the web app origin. It may be localhost during development.
WEB_ORIGIN=http://localhost:5173
# Comma-separated additional browser origins. Include the deployed frontend origin here.
WEB_ORIGINS=
# Production defaults to none for cross-origin HTTPS session cookies; secure is always enabled in production.
# COOKIE_SAME_SITE=none
# Generate: openssl rand -base64 48 (do not use this literal placeholder)
JWT_SECRET=replace-with-a-random-48-byte-base64-secret
CHURCH_TIMEZONE=Africa/Addis_Ababa

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Church Admin <your-account@gmail.com>"
EMAIL_TO=your-inbox@example.com

TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-or-group-id
TELEGRAM_BOT_USERNAME=your-bot-username
TELEGRAM_WEBHOOK_URL=https://api.example.org/api/telegram/webhook
# Generate with: openssl rand -hex 32. Required for webhook mode.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Disabled by default to avoid restart/hot-reload message spam. Set true only for a deliberate administrator delivery check.
TELEGRAM_SEND_STARTUP_CONFIRMATION=false

CHURCH_NAME=Your Church Name
CHURCH_LOGO_URL=https://example.org/images/church-logo.png
WELCOME_BANNER_URL=https://example.org/images/welcome-banner.jpg
# Telegram website buttons require a reachable public HTTPS URL. Use a tunnel for local testing.
CHURCH_WEBSITE_URL=https://example.org
CHURCH_ABOUT_URL=https://example.org/about
CHURCH_PROGRAMS_URL=https://example.org/programs
CHURCH_GIVING_URL=https://example.org/giving
CHURCH_CONTACT_EMAIL=hello@example.org
CHURCH_FACEBOOK_URL=https://facebook.com/your-page
CHURCH_INSTAGRAM_URL=https://instagram.com/your-account
CHURCH_YOUTUBE_URL=https://youtube.com/@your-channel
CHURCH_TELEGRAM_URL=https://t.me/your-channel
WELCOME_BIBLE_VERSE="Now the God of hope fill you with all joy and peace in believing, that ye may abound in hope, through the power of the Holy Ghost."
WELCOME_BIBLE_REFERENCE=Romans 15:13 (KJV)

# For Aiven or Render, use the service URI and configure the provider CA as a Render Secret File when required.
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=verify-full
# PGSSLROOTCERT=/etc/secrets/postgres-ca.pem
# The individual settings below are for local PostgreSQL when DATABASE_URL is unset.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=church_notifications
PGUSER=postgres
PGPASSWORD=your-postgres-password
# Optional: true/false overrides the DATABASE_URL sslmode in development.
# Production always requires TLS and verifies the server certificate.
# PGSSL=true
# sslmode=require encrypts the connection but does not verify the server cert.
# Use Aiven's downloaded CA certificate with PGSSLROOTCERT when required.
# PGSSL_REJECT_UNAUTHORIZED=true

# Generate a long random value; send it as Authorization: Bearer <key> in Postman.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Required to let authorized group leaders upload post images through the server.
# Keep the real value in server/.env; never put it in a VITE_* variable.
IMGBB_API_KEY=your-imgbb-api-key

# Optional one-time development/first-deployment administrator.  Production
# requires ALLOW_INITIAL_ADMIN=true and must never use sample credentials.
INITIAL_ADMIN_EMAIL=owner@example.org
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-14-character-minimum-password
INITIAL_ADMIN_NAME=Initial Administrator
INITIAL_ADMIN_PHONE=+251900000000
INITIAL_ADMIN_TELEGRAM_USER_ID=your-telegram-user-id

ALLOW_INITIAL_ADMIN=false
# Optional one-time owner bootstrap. Set this to the initial administrator's
# email only for the first trusted deployment, then remove both values.
INITIAL_SYSTEM_OWNER_EMAIL=owner@example.org
ALLOW_INITIAL_SYSTEM_OWNER=false
