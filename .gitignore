# ============================================================================
# Root ignore rules — church website (PERN)
# Sub-packages (server/, client/) keep their own .gitignore; these rules apply
# repo-wide and, critically, stop secrets and build artifacts from being
# committed. Never commit real credentials.
# ============================================================================

# --- Secrets (never commit) ---
# Ignore every .env variant, but keep the committed examples/templates.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Build output ---
dist/
build/
**/dist/
**/build/
client/dist-ssr/
*.local

# --- Logs ---
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing / coverage ---
coverage/
**/coverage/
.nyc_output/

# --- Uploads / runtime data (never commit user or asset uploads) ---
# Local file-upload targets. Persisted media lives in the database or object
# storage, not in the repository.
uploads/
**/uploads/
server/tmp/
server/public/uploads/

# --- Editor / OS noise ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Misc ---
*.tsbuildinfo
.cache/
